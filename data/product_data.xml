<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="product_pago_taller" model="product.template">
        <field name="name">Pago de Taller</field>
        <field name="default_code">PAGO_TALLER</field>
        <field name="type">service</field>
        <field name="available_in_pos" eval="True"/>
        <field name="sale_ok" eval="True"/>
