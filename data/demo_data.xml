<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ========== PRODUCTO: VENTANA ========== -->
    <record id="product_ventana" model="vidrios.product">
        <field name="name">Ventana</field>
        <field name="price_m2">120.00</field>
        <field name="min_price">25.00</field>
    </record>

    <!-- Características de Ventana -->
    <record id="char_ventana_color" model="vidrios.characteristic">
        <field name="product_id" ref="product_ventana"/>
        <field name="name">Color de perfil</field>
        <field name="sequence">10</field>
        <field name="field_type">select</field>
        <field name="selection_values">Bronce,Natural,Blanco,Negro</field>
        <field name="visible_on_ticket">True</field>
        <field name="ticket_label">Color</field>
    </record>

    <record id="char_ventana_tipo_vidrio" model="vidrios.characteristic">
        <field name="product_id" ref="product_ventana"/>
        <field name="name">Tipo de vidrio</field>
        <field name="sequence">20</field>
        <field name="field_type">select</field>
        <field name="selection_values">Claro 3mm,Claro 4mm,Claro 6mm,Bronce 4mm,Reflectivo</field>
        <field name="visible_on_ticket">True</field>
        <field name="ticket_label">Vidrio</field>
    </record>

    <record id="char_ventana_tipo_apertura" model="vidrios.characteristic">
        <field name="product_id" ref="product_ventana"/>
        <field name="name">Tipo de apertura</field>
        <field name="sequence">30</field>
        <field name="field_type">select</field>
        <field name="selection_values">Corrediza,Batiente,Fija,Proyectante</field>
        <field name="visible_on_ticket">False</field>
    </record>

    <record id="char_ventana_mosquitero" model="vidrios.characteristic">
        <field name="product_id" ref="product_ventana"/>
        <field name="name">Incluye mosquitero</field>
        <field name="sequence">40</field>
        <field name="field_type">boolean</field>
        <field name="visible_on_ticket">True</field>
        <field name="ticket_label">Mosquitero</field>
    </record>

    <record id="char_ventana_hojas" model="vidrios.characteristic">
        <field name="product_id" ref="product_ventana"/>
        <field name="name">Número de hojas</field>
        <field name="sequence">50</field>
        <field name="field_type">select</field>
        <field name="selection_values">1,2,3,4</field>
        <field name="visible_on_ticket">False</field>
    </record>

    <!--
        Fórmulas de despiece: Ventana corrediza 2 hojas.
        El campo "name" se omite intencionalmente — se calcula
        automáticamente desde material_product_id.display_name una vez
        que el post_init_hook enlaza los productos de inventario.
    -->
    <record id="formula_ventana_riel_sup" model="vidrios.formula">
        <field name="product_id" ref="product_ventana"/>
        <field name="sequence">10</field>
        <field name="material_type">profile</field>
        <field name="base_dimension">width</field>
        <field name="divisor">1</field>
        <field name="addition">0</field>
        <field name="deduction">0</field>
        <field name="quantity">1</field>
    </record>

    <record id="formula_ventana_riel_inf" model="vidrios.formula">
        <field name="product_id" ref="product_ventana"/>
        <field name="sequence">20</field>
        <field name="material_type">profile</field>
        <field name="base_dimension">width</field>
        <field name="divisor">1</field>
        <field name="addition">0</field>
        <field name="deduction">0</field>
        <field name="quantity">1</field>
    </record>

    <record id="formula_ventana_jamba_izq" model="vidrios.formula">
        <field name="product_id" ref="product_ventana"/>
        <field name="sequence">30</field>
        <field name="material_type">profile</field>
        <field name="base_dimension">height</field>
        <field name="divisor">1</field>
        <field name="addition">0</field>
        <field name="deduction">0</field>
        <field name="quantity">1</field>
    </record>

    <record id="formula_ventana_jamba_der" model="vidrios.formula">
        <field name="product_id" ref="product_ventana"/>
        <field name="sequence">40</field>
        <field name="material_type">profile</field>
        <field name="base_dimension">height</field>
        <field name="divisor">1</field>
        <field name="addition">0</field>
        <field name="deduction">0</field>
        <field name="quantity">1</field>
    </record>

    <record id="formula_ventana_hoja_h" model="vidrios.formula">
        <field name="product_id" ref="product_ventana"/>
        <field name="sequence">50</field>
        <field name="material_type">profile</field>
        <field name="base_dimension">width</field>
        <field name="divisor">2</field>
        <field name="addition">0</field>
        <field name="deduction">1.5</field>
        <field name="quantity">4</field>
        <field name="notes">2 hojas × 2 horizontales</field>
    </record>

    <record id="formula_ventana_hoja_v" model="vidrios.formula">
        <field name="product_id" ref="product_ventana"/>
        <field name="sequence">60</field>
        <field name="material_type">profile</field>
        <field name="base_dimension">height</field>
        <field name="divisor">1</field>
        <field name="addition">0</field>
        <field name="deduction">3</field>
        <field name="quantity">4</field>
        <field name="notes">2 hojas × 2 verticales</field>
    </record>

    <record id="formula_ventana_vidrio" model="vidrios.formula">
        <field name="product_id" ref="product_ventana"/>
        <field name="sequence">70</field>
        <field name="material_type">glass</field>
        <field name="glass_width_deduction">2</field>
        <field name="glass_height_deduction">4</field>
        <field name="quantity">2</field>
        <field name="notes">Medida de alto: altura - 4 cm</field>
    </record>

    <!-- ========== PRODUCTO: VITRINA ========== -->
    <record id="product_vitrina" model="vidrios.product">
        <field name="name">Vitrina</field>
        <field name="price_m2">180.00</field>
        <field name="min_price">80.00</field>
    </record>

    <record id="char_vitrina_color" model="vidrios.characteristic">
        <field name="product_id" ref="product_vitrina"/>
        <field name="name">Color de perfil</field>
        <field name="sequence">10</field>
        <field name="field_type">select</field>
        <field name="selection_values">Bronce,Natural,Negro</field>
        <field name="visible_on_ticket">True</field>
        <field name="ticket_label">Color</field>
    </record>

    <record id="char_vitrina_descripcion" model="vidrios.characteristic">
        <field name="product_id" ref="product_vitrina"/>
        <field name="name">Descripción especial</field>
        <field name="sequence">20</field>
        <field name="field_type">char</field>
        <field name="visible_on_ticket">True</field>
        <field name="ticket_label">Detalle</field>
    </record>

    <record id="char_vitrina_puertas" model="vidrios.characteristic">
