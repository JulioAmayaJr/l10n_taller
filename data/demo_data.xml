    <record id="char_pecera_espesor" model="vidrios.characteristic">
        <field name="product_id" ref="product_pecera"/>
        <field name="name">Espesor del vidrio</field>
        <field name="sequence">10</field>
        <field name="field_type">select</field>
        <field name="selection_values">4mm,6mm,8mm,10mm,12mm</field>
        <field name="visible_on_ticket">True</field>
        <field name="ticket_label">Espesor</field>
    </record>

    <record id="char_pecera_silicona" model="vidrios.characteristic">
        <field name="product_id" ref="product_pecera"/>
        <field name="name">Color de silicona</field>
        <field name="sequence">20</field>
        <field name="field_type">select</field>
        <field name="selection_values">Transparente,Negro,Blanco</field>
        <field name="visible_on_ticket">True</field>
        <field name="ticket_label">Silicona</field>
    </record>

    <record id="char_pecera_tapa" model="vidrios.characteristic">
        <field name="product_id" ref="product_pecera"/>
        <field name="name">Incluye tapa</field>
        <field name="sequence">30</field>
        <field name="field_type">boolean</field>
        <field name="visible_on_ticket">True</field>
        <field name="ticket_label">Con tapa</field>
    </record>

    <!-- ========== PRODUCTO: ESPEJO ========== -->
    <record id="product_espejo" model="vidrios.product">
        <field name="name">Espejo</field>
        <field name="price_m2">85.00</field>
        <field name="min_price">15.00</field>
    </record>

    <record id="char_espejo_tipo" model="vidrios.characteristic">
        <field name="product_id" ref="product_espejo"/>
        <field name="name">Tipo de espejo</field>
        <field name="sequence">10</field>
        <field name="field_type">select</field>
        <field name="selection_values">Normal,Biselado,Con marco,Sin marco</field>
        <field name="visible_on_ticket">True</field>
        <field name="ticket_label">Tipo</field>
    </record>

    <record id="char_espejo_espesor" model="vidrios.characteristic">
        <field name="product_id" ref="product_espejo"/>
        <field name="name">Espesor</field>
        <field name="sequence">20</field>
        <field name="field_type">select</field>
        <field name="selection_values">3mm,4mm,6mm</field>
        <field name="visible_on_ticket">False</field>
    </record>

    <record id="char_espejo_observacion" model="vidrios.characteristic">
        <field name="product_id" ref="product_espejo"/>
        <field name="name">Observaciones</field>
        <field name="sequence">30</field>
        <field name="field_type">char</field>
        <field name="visible_on_ticket">False</field>
    </record>

    <!-- ========== PRODUCTO: VENTANA FRANCESA ========== -->
    <record id="product_ventana_francesa" model="vidrios.product">
        <field name="name">Ventana Francesa</field>
        <field name="price_m2">150.00</field>
        <field name="min_price">35.00</field>
    </record>

    <record id="char_vf_color" model="vidrios.characteristic">
        <field name="product_id" ref="product_ventana_francesa"/>
        <field name="name">Color de perfil</field>
        <field name="sequence">10</field>
        <field name="field_type">select</field>
        <field name="selection_values">Bronce,Natural,Blanco,Negro</field>
        <field name="visible_on_ticket">True</field>
        <field name="ticket_label">Color</field>
    </record>

    <record id="char_vf_tipo_vidrio" model="vidrios.characteristic">
        <field name="product_id" ref="product_ventana_francesa"/>
        <field name="name">Tipo de vidrio</field>
        <field name="sequence">20</field>
        <field name="field_type">select</field>
        <field name="selection_values">Claro 4mm,Claro 6mm,Bronce 4mm</field>
        <field name="visible_on_ticket">True</field>
        <field name="ticket_label">Vidrio</field>
    </record>

    <!-- Felpa: linear, largo = (2*ancho + 2*alto)/100 metros -->
    <record id="formula_vf_felpa" model="vidrios.formula">
        <field name="product_id" ref="product_ventana_francesa"/>
        <field name="sequence">10</field>
        <field name="material_type">linear</field>
        <field name="width_coef">2.0</field>
        <field name="height_coef">2.0</field>
        <field name="linear_constant">0.0</field>
        <field name="quantity">1</field>
    </record>

    <!-- Baquelita: linear, largo = (3*ancho + 6*alto)/100 metros -->
    <record id="formula_vf_baquelita" model="vidrios.formula">
        <field name="product_id" ref="product_ventana_francesa"/>
        <field name="sequence">20</field>
        <field name="material_type">linear</field>
        <field name="width_coef">3.0</field>
        <field name="height_coef">6.0</field>
        <field name="linear_constant">0.0</field>
        <field name="quantity">1</field>
    </record>

    <!-- Rodo: herraje, 2 unidades fijas -->
    <record id="formula_vf_rodo" model="vidrios.formula">
        <field name="product_id" ref="product_ventana_francesa"/>
        <field name="sequence">30</field>
        <field name="material_type">hardware</field>
        <field name="base_dimension">fixed</field>
        <field name="quantity">2</field>
    </record>

    <!-- Cerrador: herraje, 1 unidad fija -->
    <record id="formula_vf_cerrador" model="vidrios.formula">
        <field name="product_id" ref="product_ventana_francesa"/>
        <field name="sequence">40</field>
        <field name="material_type">hardware</field>
        <field name="base_dimension">fixed</field>
        <field name="quantity">1</field>
    </record>

    <!--
        ========== FÓRMULAS DE DESPIECE: PECERA / ACUARIO ==========

        Medidas del artículo: Largo (depth) × Alto (height) × Ancho (width)

        Ejemplo Pecera 100×40×30:
          - Panel Largo×Alto  (frente/fondo)   : 100×40 cm  × 2 piezas
          - Panel Largo×Ancho (techo/piso)     : 100×30 cm  × 2 piezas
          - Panel Alto×(Ancho-1.2) (laterales) :  40×28.8 cm × 2 piezas
          - Silicón                            : 20 cm = 0.20 m  × 1
          - Vinil negro                        : 10 cm = 0.10 m  × 1
    -->

    <!-- Vidrio Largo×Alto: paneles frente y fondo -->
    <record id="formula_pecera_vidrio_largo_alto" model="vidrios.formula">
        <field name="product_id" ref="product_pecera"/>
        <field name="sequence">10</field>
        <field name="material_type">glass</field>
        <field name="glass_dim_a">depth</field>
        <field name="glass_dim_b">height</field>
        <field name="glass_width_deduction">0</field>
        <field name="glass_height_deduction">0</field>
        <field name="quantity">2</field>
        <field name="notes">Frente y fondo: Largo × Alto</field>
    </record>

    <!-- Vidrio Largo×Ancho: paneles techo y piso -->
    <record id="formula_pecera_vidrio_largo_ancho" model="vidrios.formula">
        <field name="product_id" ref="product_pecera"/>
        <field name="sequence">20</field>
        <field name="material_type">glass</field>
        <field name="glass_dim_a">depth</field>
        <field name="glass_dim_b">width</field>
        <field name="glass_width_deduction">0</field>
        <field name="glass_height_deduction">0</field>
        <field name="quantity">2</field>
        <field name="notes">Techo y piso: Largo × Ancho</field>
    </record>

    <!-- Vidrio Alto×(Ancho-1.2): paneles laterales con deducción en Ancho -->
    <record id="formula_pecera_vidrio_lateral" model="vidrios.formula">
        <field name="product_id" ref="product_pecera"/>
        <field name="sequence">30</field>
        <field name="material_type">glass</field>
        <field name="glass_dim_a">height</field>
        <field name="glass_dim_b">width</field>
        <field name="glass_width_deduction">0</field>
        <field name="glass_height_deduction">1.2</field>
        <field name="quantity">2</field>
        <field name="notes">Laterales: Alto × (Ancho - 1.2 cm)</field>
    </record>

    <!-- Silicón: herraje con cantidad decimal — 0.2 tubos por pieza -->
    <record id="formula_pecera_silicon" model="vidrios.formula">
        <field name="product_id" ref="product_pecera"/>
        <field name="sequence">40</field>
        <field name="material_type">hardware</field>
        <field name="quantity">0.2</field>
        <field name="notes">Silicón sellador (0.2 tubo/pieza)</field>
    </record>

    <!-- Vinil negro: material lineal, constante 10 cm = 0.10 m -->
    <record id="formula_pecera_vinil" model="vidrios.formula">
        <field name="product_id" ref="product_pecera"/>
        <field name="sequence">50</field>
        <field name="material_type">linear</field>
        <field name="linear_constant">10.0</field>
        <field name="quantity">1</field>
        <field name="notes">Vinil negro borde (0.10 m)</field>
    </record>

</odoo>
