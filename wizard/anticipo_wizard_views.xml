<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vidrios_anticipo_wizard_form" model="ir.ui.view">
        <field name="name">vidrios.anticipo.wizard.form</field>
        <field name="model">vidrios.anticipo.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar Anticipo">
                <group>
                    <group string="Datos del anticipo">
                        <field name="order_id" readonly="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="amount"/>
                        <field name="journal_id"
                               domain="[('type','in',('cash','bank')),('company_id','=',company_id)]"
                               options="{'no_create': True}"/>
                        <field name="payment_date"/>
                        <field name="memo"/>
                    </group>
                    <group string="Resumen">
                        <field name="order_total" widget="monetary"/>
                        <field name="order_paid" widget="monetary"/>
                        <field name="order_due" widget="monetary"/>
                    </group>
                </group>
                <footer>
                    <button name="action_register" string="Registrar Anticipo"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
