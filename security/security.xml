<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Odoo 19: res.groups ya NO tiene category_id.
        El nuevo modelo es res.groups.privilege, y los grupos referencian privilege_id.
    -->

    <record id="vidrios_privilege" model="res.groups.privilege">
        <field name="name">Taller Vidrios Castillo</field>
        <field name="sequence">100</field>
    </record>

    <!-- =============== GRUPOS =============== -->

    <record id="group_vidrios_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="privilege_id" ref="vidrios_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Acceso total: productos, precios, fórmulas, cancelar órdenes.</field>
    </record>

    <record id="group_vidrios_vendedor" model="res.groups">
        <field name="name">Vendedor</field>
        <field name="privilege_id" ref="vidrios_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Crear cotizaciones, registrar anticipos, imprimir ticket cliente.</field>
    </record>

    <record id="group_vidrios_taller" model="res.groups">
        <field name="name">Taller</field>
        <field name="privilege_id" ref="vidrios_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Ver medidas y despiece, cambiar estado de producción.</field>
    </record>

    <record id="group_vidrios_caja" model="res.groups">
        <field name="name">Caja Administracion</field>
        <field name="privilege_id" ref="vidrios_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Ver pagos, saldos y anticipos.</field>
    </record>

</odoo>
