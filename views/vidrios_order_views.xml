<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== LÍNEA DE ORDEN – FORM STANDALONE ==================== -->
    <!--
        Vista independiente de vidrios.order.line.
        Usada por action_save_and_duplicate para abrir la copia en un nuevo dialog
        (target='new'). Contenido idéntico al inline form del One2many.
    -->
    <record id="view_vidrios_order_line_form" model="ir.ui.view">
        <field name="name">vidrios.order.line.form</field>
        <field name="model">vidrios.order.line</field>
        <field name="arch" type="xml">
            <form string="Artículo de Orden">
                <group>
                    <group string="Producto y cantidad">
                        <field name="product_id" options="{'no_create': True}" required="1"/>
                        <field name="quantity"/>
                        <field name="notes" placeholder="Observaciones de la línea..."/>
                    </group>
                    <group string="Medidas">
                        <field name="width" string="Ancho (cm)"/>
                        <field name="height" string="Alto (cm)"/>
                        <field name="product_requires_depth" invisible="1"/>
                        <field name="depth" string="Largo (cm)"
                               invisible="not product_requires_depth"/>
                        <field name="area" string="Área m²" readonly="1"/>
                    </group>
                </group>

                <group string="Precio"
                       groups="vidrios_castillo_taller.group_vidrios_admin,vidrios_castillo_taller.group_vidrios_vendedor">
                    <group>
                        <field name="price_manual" string="Precio fijado manualmente"
                               readonly="1" widget="boolean_toggle"/>
                        <button name="action_reset_price"
                                string="↺ Restaurar precio de fórmula"
                                type="object"
                                class="btn-link btn-sm text-warning"
                                invisible="not price_manual"/>
                    </group>
                    <group>
                        <field name="price_unit" string="Precio unitario"/>
                        <field name="price_modules" string="Complementos" readonly="1"
                               invisible="not modulo_ids"/>
                        <field name="price_subtotal" string="Subtotal" readonly="1"/>
                    </group>
                </group>
                <group groups="vidrios_castillo_taller.group_vidrios_caja">
                    <field name="price_unit" string="Precio unitario" readonly="1"/>
                    <field name="price_modules" string="Complementos" readonly="1"
                           invisible="not modulo_ids"/>
                    <field name="price_subtotal" string="Subtotal" readonly="1"/>
                </group>

                <separator string="Características"
                           invisible="not characteristic_value_ids"/>
                <field name="characteristic_value_ids"
                       invisible="not characteristic_value_ids" nolabel="1">
                    <list editable="bottom" create="false" delete="false">
                        <field name="characteristic_id" column_invisible="1"
                               readonly="1" force_save="1"/>
                        <field name="field_type" column_invisible="1" force_save="1"/>
                        <field name="char_name" string="Característica" readonly="1"/>
                        <field name="value_option_id" string="Valor"
                               invisible="field_type != 'select'"
                               domain="[('characteristic_id', '=', characteristic_id)]"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="value_char" string="Valor"
                               invisible="field_type != 'char'"/>
                        <field name="value_boolean" string="Sí/No"
                               widget="boolean_toggle"
                               invisible="field_type != 'boolean'"/>
                    </list>
                </field>

                <field name="available_modulo_ids" invisible="1"/>
                <separator string="Complementos"
                           invisible="not available_modulo_ids"/>
                <field name="modulo_ids" widget="many2many_tags"
                       string="Complementos activos"
                       invisible="not available_modulo_ids"
                       domain="[('id','in',available_modulo_ids)]"
                       nolabel="1"
                       options="{'no_create': True, 'no_open': True}"/>
            </form>
        </field>
    </record>

    <!-- ==================== ORDEN - KANBAN ==================== -->

    <record id="view_vidrios_order_kanban" model="ir.ui.view">
        <field name="name">vidrios.order.kanban</field>
        <field name="model">vidrios.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="state"/>
                <field name="partner_id"/>
                <field name="quick_name"/>
                <field name="amount_total"/>
                <field name="amount_due"/>
                <field name="delivery_date"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div>
                                <t t-if="record.partner_id.value">
                                    <field name="partner_id"/>
                                </t>
                                <t t-else="">
                                    <span t-esc="record.quick_name.value"/>
                                </t>
                            </div>
                            <div>Total: <field name="amount_total" widget="monetary"/></div>
                            <div>Saldo: <field name="amount_due" widget="monetary"/></div>
                            <div t-if="record.delivery_date.value">
                                Entrega: <field name="delivery_date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==================== ORDEN - LIST ==================== -->

    <record id="view_vidrios_order_list" model="ir.ui.view">
        <field name="name">vidrios.order.list</field>
        <field name="model">vidrios.order</field>
        <field name="arch" type="xml">
            <list string="Órdenes de Taller" decoration-danger="amount_due > 0 and state == 'delivered'"
                  decoration-muted="state == 'cancel'"
                  decoration-success="state == 'delivered'">
                <field name="name"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft','quoted')"
                       decoration-warning="state in ('deposit','production')"
                       decoration-success="state == 'delivered'"
                       decoration-danger="state == 'cancel'"/>
                <field name="partner_id" optional="show"/>
                <field name="quick_name" optional="show"/>
                <field name="quick_phone" optional="show"/>
                <field name="amount_total" string="Total"/>
                <field name="amount_paid" string="Anticipo"/>
                <field name="amount_due" string="Saldo"/>
                <field name="delivery_date" string="Entrega"/>
            </list>
        </field>
    </record>

    <!-- ==================== ORDEN - FORM ==================== -->

    <record id="view_vidrios_order_form" model="ir.ui.view">
        <field name="name">vidrios.order.form</field>
        <field name="model">vidrios.order</field>
        <field name="arch" type="xml">
            <form string="Orden de Taller">
                <header>
                    <button name="action_quote" string="Cotizar"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_register_deposit" string="Registrar Anticipo"
                            type="object" class="btn-primary"
                            invisible="state == 'cancel' or amount_due &lt;= 0"/>
                    <button name="action_to_production" string="A Producción"
                            type="object" class="btn-primary"
                            invisible="state not in ('quoted','deposit')"/>
                    <button name="action_ready" string="Marcar Listo"
                            type="object" class="btn-primary"
                            invisible="state != 'production'"/>
                    <button name="action_delivered" string="Entregar"
                            type="object" class="btn-primary"
                            invisible="state != 'ready'"/>
                    <button name="action_print_ticket" string="Ticket (Carta)"
                            type="object" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <button name="action_print_ticket_rollo" string="Ticket (Rollo)"
                            type="object" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <button name="action_print_orden_interna" string="Orden (Carta)"
                            type="object" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <button name="action_print_orden_interna_rollo" string="Orden (Rollo)"
                            type="object" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <button name="action_draft" string="Volver a Borrador"
                            type="object" class="btn-secondary"
                            invisible="state not in ('cancel','quoted')"/>
                    <button name="action_cancel" string="Cancelar"
                            type="object" class="btn-danger"
                            groups="vidrios_castillo_taller.group_vidrios_admin"
                            invisible="state in ('delivered','cancel')"/>
                    <button name="action_recompute_materials" string="↻ Materiales"
                            type="object" class="btn-secondary"
                            title="Recalcular materiales estimados"
                            invisible="state in ('delivered','cancel','draft')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,quoted,deposit,production,ready,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Cliente">
                            <field name="partner_id"/>
                            <field name="quick_name" placeholder="Nombre rápido (sin cliente)"
                                   invisible="partner_id != False"/>
                            <field name="quick_phone" placeholder="Teléfono"
                                   invisible="partner_id != False"/>
                        </group>
                        <group string="Entrega y notas">
                            <field name="delivery_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Líneas de cotización" name="lines">
                            <field name="line_ids">

                                <!-- Lista resumen — clic en una fila abre el popup -->
                                <!-- decoration-warning resalta filas con precio manual -->
                                <list string="Artículos"
                                      decoration-warning="price_manual">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" string="Producto"/>
                                    <field name="quantity" string="Cant."/>
                                    <field name="width" string="Ancho"/>
                                    <field name="height" string="Alto"/>
                                    <field name="depth" string="Largo" optional="show"/>
                                    <field name="area" string="m²" readonly="1"/>
                                    <field name="char_summary"
                                           string="Caract." readonly="1"/>
                                    <!-- price_manual: invisible pero cargado para decoration y onchange -->
                                    <field name="price_manual" column_invisible="1"/>
                                    <field name="price_unit" string="P.Unit."
                                           groups="vidrios_castillo_taller.group_vidrios_admin,vidrios_castillo_taller.group_vidrios_vendedor"/>
                                    <field name="price_subtotal" string="Subtotal" readonly="1"
                                           groups="vidrios_castillo_taller.group_vidrios_vendedor,vidrios_castillo_taller.group_vidrios_admin,vidrios_castillo_taller.group_vidrios_caja"/>
                                    <field name="notes" string="Notas" optional="hide"/>
                                    <!-- Botón duplicar por fila -->
                                    <button name="action_duplicate_line"
                                            string=""
                                            type="object"
                                            icon="fa-clone"
                                            title="Duplicar esta línea"
                                            class="btn-sm"/>
                                </list>

                                <!-- Popup de edición por línea -->
                                <form string="Artículo de Orden">
                                    <group>
                                        <group string="Producto y cantidad">
                                            <field name="product_id"
                                                   options="{'no_create': True}"
                                                   required="1"/>
                                            <field name="quantity"/>
                                            <field name="notes"
                                                   placeholder="Observaciones de la línea..."/>
                                        </group>
                                        <group string="Medidas">
                                            <field name="width" string="Ancho (cm)"/>
                                            <field name="height" string="Alto (cm)"/>
                                            <!--
                                                product_requires_depth es del PRODUCTO, no de la línea.
                                                Se carga invisible para que el campo depth lo use
                                                en su condición invisible.
                                            -->
                                            <field name="product_requires_depth" invisible="1"/>
                                            <field name="depth" string="Largo (cm)"
                                                   invisible="not product_requires_depth"/>
                                            <field name="area" string="Área m²" readonly="1"/>
                                        </group>
                                    </group>

                                    <!-- Sección de precio: editable para admin/vendedor -->
                                    <group string="Precio"
                                           groups="vidrios_castillo_taller.group_vidrios_admin,vidrios_castillo_taller.group_vidrios_vendedor">
                                        <group>
                                            <!-- price_manual visible como check pequeño; solo lectura -->
                                            <field name="price_manual"
                                                   string="Precio fijado manualmente"
                                                   readonly="1"
                                                   widget="boolean_toggle"/>
                                            <!-- Botón para restaurar precio de fórmula -->
                                            <button name="action_reset_price"
                                                    string="↺ Restaurar precio de fórmula"
                                                    type="object"
                                                    class="btn-link btn-sm text-warning"
                                                    invisible="not price_manual"/>
                                        </group>
                                        <group>
                                            <field name="price_unit" string="Precio unitario"/>
                                            <field name="price_modules" string="Complementos"
                                                   readonly="1"
                                                   invisible="not modulo_ids"/>
                                            <field name="price_subtotal" string="Subtotal"
                                                   readonly="1"/>
                                        </group>
                                    </group>
                                    <!-- Subtotal visible para caja (solo lectura) -->
                                    <group groups="vidrios_castillo_taller.group_vidrios_caja">
                                        <field name="price_unit" string="Precio unitario"
                                               readonly="1"/>
                                        <field name="price_subtotal" string="Subtotal"
                                               readonly="1"/>
                                    </group>

                                    <!-- Características del producto -->
                                    <separator string="Características"
                                               invisible="not characteristic_value_ids"/>
                                    <field name="characteristic_value_ids"
                                           invisible="not characteristic_value_ids"
                                           nolabel="1">
                                        <list editable="bottom" create="false" delete="false">

                                            <!--
                                                characteristic_id y field_type son readonly, pero
                                                force_save="1" fuerza al cliente a enviarlos en el
                                                payload de guardado. Sin esto, Odoo omite los campos
                                                readonly y la BD rechaza la fila por falta de
                                                characteristic_id (required=True).
                                            -->
                                            <field name="characteristic_id"
                                                   column_invisible="1"
                                                   readonly="1"
                                                   force_save="1"/>
                                            <field name="field_type"
                                                   column_invisible="1"
                                                   force_save="1"/>

                                            <!-- Nombre de la característica (solo lectura) -->
                                            <field name="char_name"
                                                   string="Característica"
                                                   readonly="1"/>

                                            <!--
                                                Columna "Valor" adaptativa según field_type:
                                                - select  → desplegable value_option_id
                                                - char    → texto libre value_char
                                                - boolean → toggle value_boolean
                                                En Odoo 19, cuando TODAS las filas tienen un campo
                                                invisible, el encabezado de columna se oculta.
                                                Para un producto con solo select, solo se ve
                                                la columna de desplegable.
                                            -->
                                            <field name="value_option_id"
                                                   string="Valor"
                                                   invisible="field_type != 'select'"
                                                   domain="[('characteristic_id', '=', characteristic_id)]"
                                                   options="{'no_create': True, 'no_open': True}"/>
                                            <field name="value_char"
                                                   string="Valor"
                                                   invisible="field_type != 'char'"/>
                                            <field name="value_boolean"
                                                   string="Sí/No"
                                                   widget="boolean_toggle"
                                                   invisible="field_type != 'boolean'"/>

                                        </list>
                                    </field>

                                    <!-- Complementos seleccionables -->
                                    <field name="available_modulo_ids" invisible="1"/>
                                    <separator string="Complementos"
                                               invisible="not available_modulo_ids"/>
                                    <field name="modulo_ids" widget="many2many_tags"
                                           string="Complementos activos"
                                           invisible="not available_modulo_ids"
                                           domain="[('id','in',available_modulo_ids)]"
                                           nolabel="1"
                                           options="{'no_create': True, 'no_open': True}"/>

                                    <!--
                                        Sin <footer> personalizado: Odoo 19 renderiza
                                        automáticamente los botones nativos del dialog
                                        (Guardar y cerrar / Guardar y crear nuevo / Descartar).
                                        El botón "Guardar y duplicar" va en el cuerpo del form.
                                        invisible="not id": solo visible cuando la línea ya está
                                        persistida (id real); evita llamadas sobre registros NewId.
                                    -->
                                    <div class="mt-3"
                                         groups="vidrios_castillo_taller.group_vidrios_admin,vidrios_castillo_taller.group_vidrios_vendedor">
                                        <button name="action_save_and_duplicate"
                                                string="Guardar y duplicar"
                                                type="object"
                                                class="btn-secondary btn-sm"
                                                title="Guarda esta línea y abre una copia lista para editar"
                                                invisible="not id"/>
                                    </div>
                                </form>

                            </field>
                        </page>

                        <page string="Extras" name="extras">
                            <field name="extra_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="price"/>
                                </list>
                            </field>
                        </page>

                        <page string="Anticipos / Pagos" name="payments"
                              groups="vidrios_castillo_taller.group_vidrios_admin,vidrios_castillo_taller.group_vidrios_vendedor,vidrios_castillo_taller.group_vidrios_caja">

                            <separator string="Pagos POS"/>
                            <field name="pos_order_ids" readonly="1" nolabel="1">
                                <list string="Pagos POS">
                                    <field name="date_order" string="Fecha"/>
                                    <field name="pos_reference" string="Referencia"/>
                                    <field name="amount_total" string="Monto"/>
                                    <field name="state" string="Estado" widget="badge"
                                           decoration-success="state in ('paid','done','invoiced')"
                                           decoration-warning="state == 'draft'"
                                           decoration-danger="state == 'cancel'"/>
                                </list>
                            </field>

                            <separator string="Anticipos (legado)" invisible="not payment_ids"/>
                            <field name="payment_ids" readonly="1" nolabel="1"
                                   invisible="not payment_ids">
                                <list>
                                    <field name="date" string="Fecha"/>
                                    <field name="memo" string="Referencia"/>
                                    <field name="journal_id" string="Método"/>
                                    <field name="amount" string="Monto"/>
                                    <field name="state" string="Estado" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <!-- ===== MATERIALES ===== -->
                        <page string="Materiales" name="materials"
                              groups="vidrios_castillo_taller.group_vidrios_admin,vidrios_castillo_taller.group_vidrios_taller">

                            <!-- Controles de stock -->
                            <group>
                                <group>
                                    <field name="consume_stock"
                                           groups="vidrios_castillo_taller.group_vidrios_admin"/>
                                    <field name="stock_consumed" readonly="1"
                                           invisible="not stock_consumed"
                                           groups="vidrios_castillo_taller.group_vidrios_admin"/>
                                </group>
                            </group>

                            <!-- Materiales USADOS (editable en producción) -->
                            <separator string="Materiales usados"
                                       invisible="state not in ('production','ready','delivered')"/>
                            <field name="used_material_ids"
                                   invisible="state not in ('production','ready','delivered')"
                                   readonly="state != 'production'"
                                   nolabel="1">
                                <list editable="bottom">
                                    <field name="product_id" string="Material"
                                           options="{'no_create': False}"/>
                                    <field name="qty_used" string="Cantidad usada"
                                           digits="[10,4]"/>
                                    <field name="uom_name" string="Unidad"/>
                                    <field name="notes" string="Nota" optional="hide"/>
                                </list>
                            </field>
                            <p class="text-muted"
                               invisible="used_material_ids or state not in ('production','ready','delivered')">
                                Sin materiales registrados. Agrega filas manualmente o recarga los estimados.
                            </p>

                            <!-- Botón recargar desde estimados (solo en producción) -->
                            <div invisible="state != 'production'">
                                <button name="action_reload_used_from_estimated"
                                        string="↻ Recargar desde estimados"
                                        type="object"
                                        class="btn-secondary btn-sm"
                                        title="Sobreescribe la lista usada con los materiales estimados actuales"
                                        groups="vidrios_castillo_taller.group_vidrios_admin,vidrios_castillo_taller.group_vidrios_taller"/>
                            </div>

                            <!-- Materiales ESTIMADOS (solo lectura, referencia) -->
                            <separator string="Materiales estimados (referencia)"/>
                            <field name="material_ids" readonly="1" nolabel="1">
                                <list>
                                    <field name="product_id" string="Material"/>
                                    <field name="qty_needed" string="Estimado"
                                           digits="[10,4]"/>
                                    <field name="uom_name" string="Unidad"/>
                                    <field name="qty_available" string="Disponible"
                                           decoration-danger="shortage"
                                           decoration-success="not shortage and qty_available > 0"/>
                                    <field name="shortage" invisible="1"/>
                                </list>
                            </field>
                            <p class="text-muted" invisible="material_ids">
                                Sin líneas de cotización enlazadas a productos de inventario.
                            </p>
                        </page>

                        <page string="Notas / Fotos" name="notes_page">
                            <field name="notes" placeholder="Observaciones generales..."/>
                            <field name="photo_ids" widget="many2many_binary" string="Fotos / Adjuntos"/>
                            <group string="Opciones de impresion"
                                   groups="vidrios_castillo_taller.group_vidrios_admin">
                                <field name="show_sp_detail"/>
                            </group>
                        </page>
                    </notebook>

                    <div class="oe_right"
                         groups="vidrios_castillo_taller.group_vidrios_admin,vidrios_castillo_taller.group_vidrios_vendedor,vidrios_castillo_taller.group_vidrios_caja">
                        <table class="table table-sm table-borderless mb-0" style="min-width:280px;">
                            <tbody>
                                <tr>
                                    <td class="text-end text-muted py-1 pe-3">Aplicar IVA</td>
                                    <td class="text-end py-1">
                                        <field name="apply_tax" nolabel="1"/>
                                    </td>
                                </tr>
                                <tr invisible="not apply_tax">
                                    <td class="text-end text-muted py-1 pe-3">Tasa IVA (%)</td>
                                    <td class="text-end py-1">
                                        <field name="tax_rate" nolabel="1"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-end text-muted py-1 pe-3">Subtotal</td>
                                    <td class="text-end py-1">
                                        <field name="amount_untaxed" nolabel="1" readonly="1"/>
                                    </td>
                                </tr>
                                <tr invisible="not apply_tax">
                                    <td class="text-end text-muted py-1 pe-3">IVA</td>
                                    <td class="text-end py-1">
                                        <field name="amount_tax" nolabel="1" readonly="1"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-end fw-bold py-2 pe-3 border-top border-2"
                                        style="font-size:1.1em;">Total</td>
                                    <td class="text-end fw-bold py-2 border-top border-2"
                                        style="font-size:1.1em;">
                                        <field name="amount_total" nolabel="1" readonly="1"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-end text-muted py-1 pe-3 border-top">Anticipo pagado</td>
                                    <td class="text-end py-1 border-top">
                                        <field name="amount_paid" nolabel="1" readonly="1"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-end text-muted py-1 pe-3">Saldo pendiente</td>
                                    <td class="text-end py-1">
                                        <field name="amount_due" nolabel="1" readonly="1"
                                               class="text-danger fw-semibold"
                                               invisible="amount_due &lt;= 0"/>
                                        <field name="amount_due" nolabel="1" readonly="1"
                                               invisible="amount_due &gt; 0"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==================== ORDEN - SEARCH ==================== -->

    <record id="view_vidrios_order_search" model="ir.ui.view">
        <field name="name">vidrios.order.search</field>
        <field name="model">vidrios.order</field>
        <field name="arch" type="xml">
            <search string="Buscar Órdenes">
                <field name="name" string="Número"/>
                <field name="partner_id" string="Cliente"/>
                <field name="quick_name" string="Nombre rápido"/>
                <field name="quick_phone" string="Teléfono"/>
                <separator/>
                <filter name="filter_draft" string="Borrador" domain="[('state','=','draft')]"/>
                <filter name="filter_quoted" string="Cotizadas" domain="[('state','=','quoted')]"/>
                <filter name="filter_deposit" string="Con anticipo" domain="[('state','=','deposit')]"/>
                <filter name="filter_production" string="En producción" domain="[('state','=','production')]"/>
                <filter name="filter_ready" string="Listas" domain="[('state','=','ready')]"/>
                <filter name="filter_delivered" string="Entregadas" domain="[('state','=','delivered')]"/>
                <filter name="filter_cancel" string="Canceladas" domain="[('state','=','cancel')]"/>
                <separator/>
                <filter name="filter_pending" string="Pendientes"
                        domain="[('state','in',('draft','quoted','deposit','production','ready'))]"/>
                <group>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_delivery" string="Fecha entrega" context="{'group_by': 'delivery_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vidrios_order" model="ir.actions.act_window">
        <field name="name">Órdenes de Taller</field>
        <field name="res_model">vidrios.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>

    <!-- Acciones auxiliares para submenús de reporte -->

    <record id="action_vidrios_order_pendientes" model="ir.actions.act_window">
        <field name="name">Órdenes Pendientes</field>
        <field name="res_model">vidrios.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','in',['draft','quoted','deposit','production','ready'])]</field>
    </record>

    <record id="action_vidrios_order_produccion" model="ir.actions.act_window">
        <field name="name">Producción Pendiente</field>
        <field name="res_model">vidrios.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','in',['production','ready'])]</field>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>

    <record id="action_vidrios_anticipos" model="ir.actions.act_window">
        <field name="name">Anticipos Recibidos</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('vidrios_order_id','!=',False),('payment_type','=','inbound')]</field>
    </record>

    <record id="action_vidrios_pagos_pos" model="ir.actions.act_window">
        <field name="name">Pagos POS de Taller</field>
        <field name="res_model">pos.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('vidrios_order_id','!=',False)]</field>
    </record>

</odoo>
