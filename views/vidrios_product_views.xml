<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== PRODUCTO ==================== -->

    <record id="view_vidrios_product_list" model="ir.ui.view">
        <field name="name">vidrios.product.list</field>
        <field name="model">vidrios.product</field>
        <field name="arch" type="xml">
            <list string="Tipos de Producto">
                <field name="name"/>
                <field name="price_m2" string="Precio/m²"/>
                <field name="min_price" string="Precio mín."/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_vidrios_product_form" model="ir.ui.view">
        <field name="name">vidrios.product.form</field>
        <field name="model">vidrios.product</field>
        <field name="arch" type="xml">
            <form string="Tipo de Producto">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre del producto..."/></h1>
                    </div>
                    <group>
                        <group string="Precio">
                            <field name="use_fixed_price" widget="boolean_toggle" string="Precio fijo"/>
                            <field name="fixed_price" string="Precio fijo ($)"
                                   invisible="not use_fixed_price"/>
                            <field name="price_m2" string="Precio por m²"
                                   invisible="use_fixed_price"/>
                            <field name="min_price" string="Precio mínimo"
                                   invisible="use_fixed_price"/>
                        </group>
                        <group string="Opciones">
                            <field name="active"/>
                            <field name="requires_depth"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Características" name="characteristics">
                            <field name="characteristic_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="field_type"/>
                                    <field name="selection_values"
                                           invisible="field_type != 'select'"
                                           required="field_type == 'select'"/>
                                    <field name="visible_on_ticket"/>
                                    <field name="ticket_label"/>
                                </list>
                            </field>
                        </page>

                        <!-- ===== FÓRMULAS DE DESPIECE ===== -->
                        <page string="Fórmulas de despiece" name="formulas">
                            <field name="formula_ids">

                                <!-- Lista compacta: sin editable inline, clic abre popup -->
                                <list string="Fórmulas">
                                    <field name="sequence" widget="handle"/>
                                    <field name="material_product_id"
                                           string="Producto (pieza)"
                                           required="1"
                                           options="{'no_create': True}"/>
                                    <field name="material_type" string="Tipo"/>
                                    <field name="quantity" string="Cant."/>
                                    <field name="formula_summary"
                                           string="Fórmula"
                                           readonly="1"/>
                                    <field name="glass_divisor_a"
                                           string="Divisor A"
                                           invisible="material_type != 'glass'"/>
                                    <field name="glass_divisor_b"
                                           string="Divisor B"
                                           invisible="material_type != 'glass'"/>
                                    <field name="notes" string="Notas" optional="hide"/>
                                </list>

                                <!-- Popup que se abre al hacer clic en una fila -->
                                <form string="Fórmula de Despiece">
                                    <group>
                                        <group string="Pieza">
                                            <field name="material_product_id"
                                                   required="1"
                                                   options="{'no_create': True}"
                                                   string="Producto de inventario"/>
                                            <field name="material_type"/>
                                            <field name="quantity"/>
                                            <field name="notes"/>
                                        </group>

                                        <group string="Parámetros de corte">
                                            <!-- Perfil -->
                                            <field name="base_dimension"
                                                   invisible="material_type != 'profile'"/>
                                            <field name="divisor"
                                                   invisible="material_type != 'profile'"/>
                                            <field name="addition"
                                                   invisible="material_type != 'profile'"/>
                                            <field name="deduction"
                                                   invisible="material_type != 'profile'"/>

                                            <!-- Vidrio -->
                                            <field name="glass_dim_a"
                                                   string="Dimensión A (panel)"
                                                   invisible="material_type != 'glass'"/>
                                            <field name="glass_divisor_a"
                                                   string="Divisor A"
                                                   invisible="material_type != 'glass'"/>
                                            <field name="glass_width_deduction"
                                                   string="Deducción A (cm)"
                                                   invisible="material_type != 'glass'"/>
                                            <field name="glass_dim_b"
                                                   string="Dimensión B (panel)"
                                                   invisible="material_type != 'glass'"/>
                                            <field name="glass_divisor_b"
                                                   string="Divisor B"
                                                   invisible="material_type != 'glass'"/>
                                            <field name="glass_height_deduction"
                                                   string="Deducción B (cm)"
                                                   invisible="material_type != 'glass'"/>

                                            <!-- Lineal -->
                                            <field name="width_coef"
                                                   invisible="material_type != 'linear'"/>
                                            <field name="height_coef"
                                                   invisible="material_type != 'linear'"/>
                                            <field name="depth_coef"
                                                   string="Coef. Largo"
                                                   invisible="material_type != 'linear'"/>
                                            <field name="linear_constant"
                                                   invisible="material_type != 'linear'"/>
                                        </group>
                                    </group>
                                </form>

                            </field>
                        </page>
                        <!-- ===== PRECIOS POR RANGO ===== -->
                        <page string="Precios por rango" name="price_tiers">
                            <p class="text-muted mb-2">
                                Opcional. Si se definen rangos, <b>reemplazan</b> el Precio por m²
                                y el Precio mínimo. El sistema aplica el último rango cuyo
                                "Desde m²" sea ≤ al área de la línea (semántica de landing, no marginal).
                            </p>
                            <field name="price_tier_ids">
                                <list editable="bottom">
                                    <field name="min_area" string="Desde m²"/>
                                    <field name="price_mode" string="Modo"/>
                                    <field name="amount" string="Precio"/>
                                </list>
                            </field>
                        </page>

                        <!-- ===== MÓDULOS / COMPLEMENTOS ===== -->
                        <page string="Módulos / Complementos" name="modules">
                            <p class="text-muted mb-2">
                                Otros productos cuyas piezas se suman al despiece de este.
                                Ejemplo: añadir "Mosquitero" a "Ventana Francesa" genera
                                automáticamente las piezas del mosquitero con las mismas
                                medidas de la línea.
                            </p>
                            <field name="modulo_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="price_m2" string="Precio/m²"/>
                                    <field name="requires_depth" string="3D"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vidrios_product" model="ir.actions.act_window">
        <field name="name">Productos</field>
        <field name="res_model">vidrios.product</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>
